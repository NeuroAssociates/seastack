{
  "name": "seastack",
  "version": "2.0.0",
  "type": "module",
  "description": "A JavaScript library for generating web documents based on data",
  "main": "dist/cjs/seastack.js",
  "module": "dist/esm/seastack.js",
  "browser": "dist/umd/seastack.js",
  "types": "dist/esm/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/types/index.d.ts",
      "import": "./dist/esm/seastack.js",
      "require": "./dist/cjs/seastack.js",
      "default": "./dist/umd/seastack.js"
    },
    "./onload": {
      "types": "./dist/esm/types/onload.d.ts",
      "import": "./dist/esm/seastack-onload.js",
      "require": "./dist/cjs/seastack-onload.js",
      "default": "./dist/umd/seastack-onload.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "seastack",
    "template",
    "json",
    "html",
    "binding"
  ],
  "author": "Neuro Associates",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "happy-dom": "^13.6.2",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "rollup": "^4.12.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
